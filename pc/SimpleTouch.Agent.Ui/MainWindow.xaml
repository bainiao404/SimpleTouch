<Window x:Class="SimpleTouch.Agent.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleTouch Agent" Height="560" Width="760"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="8">
        <!-- ① 连接 -->
        <TabItem Header="连接">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="目标设备" VerticalAlignment="Center" Width="70" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              Width="280" VerticalAlignment="Center" />
                    <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                    <Button Content="启动连接" Command="{Binding StartCommand}" Background="#6750A4" Foreground="White" />
                    <Button Content="断开" Command="{Binding StopCommand}" />
                    <Button Content="诊断" Command="{Binding DiagnoseCommand}" ToolTip="枚举该设备的蓝牙服务与 SDP 记录（输出见日志页）" />
                    <Button Content="重新配对…" Command="{Binding RepairCommand}" ToolTip="删除配对后由平板端重新发起（需在平板蓝牙设置页确认）" />
                </StackPanel>

                <Border Grid.Row="2" Background="#F3EFF9" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding PeerText}" Margin="0,4,0,0" Foreground="#444444" />
                        <TextBlock Text="{Binding CapsText}" Margin="0,2,0,0" Foreground="#444444" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Text="断线后自动按 1s→30s 退避重连；手机端会保持监听等待重连，无需手动操作。"
                           Margin="0,8,0,0" FontSize="12" Foreground="#777777" TextWrapping="Wrap" />
            </Grid>
        </TabItem>

        <!-- ② 设置 -->
        <TabItem Header="设置">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4">
                    <TextBlock>
                        <Run Text="指针灵敏度  " /><Run Text="{Binding MoveScale, Mode=OneWay, StringFormat={}{0:0.##}×}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Slider Minimum="0.1" Maximum="3" Value="{Binding MoveScale}"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4" />
                    <TextBlock Text="提示：Windows 指针加速会再叠加（综合 ≈2.2×），感觉过快就调低；改动即时生效并落盘 settings.json"
                               FontSize="12" Foreground="#777777" TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Hotkeys}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          Margin="0,12,0,0" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="presetId" Binding="{Binding IdHex}" Width="80" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="VK" Binding="{Binding Vk}" Width="70" />
                        <DataGridTextColumn Header="修饰键" Binding="{Binding Mods}" Width="110" />
                        <DataGridTextColumn Header="按住" Binding="{Binding HoldMs}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="重新加载" Command="{Binding ReloadHotkeysCommand}"
                            ToolTip="重读 hotkeys.json（手机端快捷键面板按此表注入）" />
                    <Button Content="打开配置文件夹" Command="{Binding OpenConfigFolderCommand}" />
                    <TextBlock Text="组合键编辑器（录制 VK/修饰键）为后续功能，当前可手动编辑 hotkeys.json 后点「重新加载」"
                               VerticalAlignment="Center" FontSize="12" Foreground="#777777" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ③ 日志 -->
        <TabItem Header="日志">
            <Grid Margin="12">
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                         FontFamily="Consolas" FontSize="12" Background="#FAFAFA" />
            </Grid>
        </TabItem>

        <!-- ④ 后续功能占位 -->
        <TabItem Header="后续功能">
            <StackPanel Margin="24,16">
                <TextBlock Text="规划中的功能（本版为占位导航）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <TextBlock Text="• 快捷键组合键编辑器 —— 录制 VK/修饰键，写入 hotkeys.json（设置页表格已有只读视图）" Margin="0,3" TextWrapping="Wrap" />
                <TextBlock Text="• 宏（按键序列）—— 协议 HOTKEY presetId 已预留宏通道" Margin="0,3" TextWrapping="Wrap" />
                <TextBlock Text="• HID 降级模式 —— core/hid + 模式切换开关（能力门控按 Capabilities 隐藏文本直注/宏/剪贴板）" Margin="0,3" TextWrapping="Wrap" />
                <TextBlock Text="• WiFi 通道 —— ITransport 第二实现（局域网 TCP），延迟/带宽更优" Margin="0,3" TextWrapping="Wrap" />
                <TextBlock Text="• 开机自启 / 随系统启动最小化 —— 注册表 Run 项 + 设置开关" Margin="0,3" TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
